#: ../modules/memoserv/ms_set.cpp:244
msgid "Syntax: NOTIFY {ON | LOGON | NEW | MAIL | NOMAIL | OFF}\n\nChanges when you will be notified about new memos:"
msgstr "Sintaxe: NOTIFY {ON | LOGON | NEW | MAIL | NOMAIL | OFF}\n\nAltera quando você será notificado sobre novos memos:"
#: ../modules/memoserv/ms_set.cpp:250
msgid "You will be notified of memos when you log on, when you unset /AWAY, and when they are sent to you."
msgstr "Você será notificado de memos quando se conectar, quando remover o /AWAY e quando eles forem enviados a você."
#: ../modules/memoserv/ms_set.cpp:251
msgid "You will only be notified of memos when you log on or when you unset /AWAY."
msgstr "Você só será notificado de memos quando se conectar ou quando remover o /AWAY."
