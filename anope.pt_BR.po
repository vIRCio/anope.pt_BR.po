#, c-format
msgid "Matches for %s:"
msgstr "Correspondências para %s:"
#: ../modules/operserv/os_logsearch.cpp:146
#, c-format
msgid "Showed %zu/%zu matches for %s."
msgstr "%zu/%zu correspondências mostradas para %s."
#: ../modules/operserv/os_logsearch.cpp:154
msgid "This command searches the services logfiles for messages that match the given pattern. The day and limit argument may be used to specify how many days of logs to search and the number of replies to limit to. By default this command searches one week of logs, and limits replies to 50."
msgstr "Este comando procura nos arquivos de log dos Serviços mensagens que correspondem ao padrão informado. O argumento de dias e limite pode ser usado para especificar quantos dias de logs serão pesquisados e o número de respostas a limitar. Por padrão, este comando pesquisa uma semana de logs e limita as respostas a 50."
#: ../modules/operserv/os_logsearch.cpp:164
msgid "Searches the last 21 days worth of logs for messages containing Anope and lists the most recent 500 of them."
msgstr "Procura nos logs dos últimos 21 dias por mensagens que contenham Anope e lista as 500 mais recentes."
#: ../modules/operserv/os_mode.cpp:23
msgid "Change channel modes"
msgstr "Alterar os modos de um canal"
#: ../modules/operserv/os_mode.cpp:24
msgid "channel modes"
msgstr "canal modos"
#: ../modules/operserv/os_mode.cpp:25
msgid "channel CLEAR [ALL]"
msgstr "canal CLEAR [ALL]"
#: ../modules/operserv/os_mode.cpp:48
#, c-format
msgid "Modes cleared on %s and the channel destroyed."
msgstr "Os modos foram limpos em %s e o canal foi destruído."
#: ../modules/operserv/os_mode.cpp:64
#, c-format
msgid "All modes cleared on %s."
msgstr "Todos os modos foram limpos em %s."
#: ../modules/operserv/os_mode.cpp:67
#, c-format
msgid "Non-status modes cleared on %s."
msgstr "Os modos sem status foram limpos em %s."
#: ../modules/operserv/os_mode.cpp:137
msgid "Allows Services Operators to change modes for any channel. Parameters are the same as for the standard /MODE command. Alternatively, CLEAR may be given to clear all modes on the channel. If CLEARALL is given then all modes, including user status, is removed."
msgstr "Permite que Operadores de Serviços alterem modos de qualquer canal. Os parâmetros são os mesmos do comando /MODE padrão. Alternativamente, pode-se informar CLEAR para limpar todos os modos do canal. Se CLEARALL for informado, todos os modos, incluindo o status de usuário, são removidos."
#: ../modules/operserv/os_mode.cpp:152
msgid "Change user modes"
msgstr "Alterar os modos de usuário"
#: ../modules/operserv/os_mode.cpp:153
msgid "user modes"
msgstr "usuário modos"
#: ../modules/operserv/os_mode.cpp:167
#, c-format
msgid "Changed user modes of %s to %s."
msgstr "Os modos de usuário de %s foram alterados para %s."
#: ../modules/operserv/os_mode.cpp:169
#, c-format
msgid "%s changed your user modes to %s."
msgstr "%s alterou seus modos de usuário para %s."
#: ../modules/operserv/os_mode.cpp:180
msgid "Allows Services Operators to change modes for any user. Parameters are the same as for the standard /MODE command."
msgstr "Permite que Operadores de Serviços alterem modos de qualquer usuário. Os parâmetros são os mesmos do comando /MODE padrão."
