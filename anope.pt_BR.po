msgstr "{mode} {param} -- criado por {creator} em {created}"
#: ../modules/chanserv/cs_mode.cpp:395
#, c-format
msgid "Mode locks for %s:"
msgstr "Bloqueios de modo de %s:"
#: ../modules/chanserv/cs_mode.cpp:478
#, c-format
msgid "Unknown modes %s ignored."
msgstr "Modos desconhecidos %s ignorados."
#: ../modules/chanserv/cs_mode.cpp:480
#, c-format
msgid "Missing parameter for modes %s."
msgstr "Parâmetro ausente para os modos %s."
#: ../modules/chanserv/cs_mode.cpp:482
#, c-format
msgid "You may not (un)lock modes %s from %s."
msgstr "Você não pode (des)bloquear os modos %s de %s."
#: ../modules/chanserv/cs_mode.cpp:486
#, c-format
msgid "List for modes %s is full."
msgstr "A lista dos modos %s está cheia."
#: ../modules/chanserv/cs_mode.cpp:488
#, c-format
msgid "The mode lock list of %s is full, unable to lock %s."
msgstr "A lista de bloqueios de modo de %s está cheia; não é possível bloquear %s."
#: ../modules/chanserv/cs_mode.cpp:490
#, c-format
msgid "%s can not be locked on %s."
msgstr "%s não pode ser bloqueado em %s."
#: ../modules/chanserv/cs_mode.cpp:493
#, c-format
msgid "%s has been locked on %s."
msgstr "%s foi bloqueado em %s."
#: ../modules/chanserv/cs_mode.cpp:499
#, c-format
msgid "%s is not locked on %s."
msgstr "%s não está bloqueado em %s."
#: ../modules/chanserv/cs_mode.cpp:502
#, c-format
msgid "%s has been unlocked from %s."
msgstr "%s foi desbloqueado de %s."
#: ../modules/chanserv/cs_mode.cpp:507
msgid "Nothing to do."
msgstr "Nada a fazer."
#: ../modules/chanserv/cs_mode.cpp:595 ../modules/chanserv/cs_mode.cpp:652
#, c-format
