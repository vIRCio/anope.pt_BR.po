msgstr "Seu bloco de oper não requer login."
#: ../modules/operserv/os_login.cpp:61
msgid "You are now a Services Operator."
msgstr "Você agora é um Operador de Serviços."
#: ../modules/operserv/os_login.cpp:70
#, c-format
msgid "Logs you in to %s so you gain Services Operator privileges. This command may be unnecessary if your oper block is configured without a password."
msgstr "Faz seu login em %s para que você obtenha privilégios de Operador de Serviços. Este comando pode ser desnecessário se o seu bloco de oper estiver configurado sem senha."
#: ../modules/operserv/os_login.cpp:80
#, c-format
msgid "Login to %s"
msgstr "Login em %s"
#: ../modules/operserv/os_login.cpp:102
msgid "You are not identified."
msgstr "Você não está identificado."
