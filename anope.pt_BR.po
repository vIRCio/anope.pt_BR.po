#: ../modules/operserv/os_news.cpp:335
msgid "Define messages to be shown to users at logon"
msgstr "Definir as mensagens que serão exibidas aos usuários no logon"
#: ../modules/operserv/os_news.cpp:348
#, c-format
msgid "Edits or displays the list of logon news messages. When a user connects to the network, these messages will be sent to them. However, no more than %d messages will be sent in order to avoid flooding the user. If there are more news messages, only the most recent will be sent."
msgstr "Edita ou exibe a lista de mensagens de notícias de logon. Quando um usuário se conecta à rede, essas mensagens são enviadas a ele. No entanto, no máximo %d mensagens são enviadas para evitar flood no usuário. Se houver mais mensagens de notícias, apenas as mais recentes são enviadas."
#: ../modules/operserv/os_news.cpp:365
msgid "Define messages to be shown to users who oper"
msgstr "Definir as mensagens que serão exibidas aos usuários que se tornam oper"
#: ../modules/operserv/os_news.cpp:378
#, c-format
msgid "Edits or displays the list of oper news messages. When a user opers up (with the /OPER command), these messages will be sent to them. However, no more than %d messages will be sent in order to avoid flooding the user. If there are more news messages, only the most recent will be sent."
msgstr "Edita ou exibe a lista de mensagens de notícias de oper. Quando um usuário se torna oper (com o comando /OPER), essas mensagens são enviadas a ele. No entanto, no máximo %d mensagens são enviadas para evitar flood no usuário. Se houver mais mensagens de notícias, apenas as mais recentes são enviadas."
#: ../modules/operserv/os_news.cpp:395
msgid "Define messages to be randomly shown to users at logon"
msgstr "Definir as mensagens que serão exibidas aleatoriamente aos usuários no logon"
#: ../modules/operserv/os_news.cpp:408
msgid "Edits or displays the list of random news messages. When a user connects to the network, one (and only one) of the random news will be randomly chosen and sent to them."
msgstr "Edita ou exibe a lista de mensagens de notícias aleatórias. Quando um usuário se conecta à rede, uma (e apenas uma) das notícias aleatórias é escolhida ao acaso e enviada a ele."
#: ../modules/operserv/os_noop.cpp:23
msgid "Remove all operators from a server remotely"
msgstr "Remover todos os operadores de um servidor remotamente"
#: ../modules/operserv/os_noop.cpp:24
msgid "SET server"
msgstr "SET servidor"
#: ../modules/operserv/os_noop.cpp:25
msgid "REVOKE server"
msgstr "REVOKE servidor"
#: ../modules/operserv/os_noop.cpp:37
msgid "You can not NOOP services."
msgstr "Você não pode fazer NOOP nos Serviços."
#: ../modules/operserv/os_noop.cpp:45
#, c-format
msgid "All operators from %s have been removed."
msgstr "Todos os operadores de %s foram removidos."
#: ../modules/operserv/os_noop.cpp:60
#, c-format
msgid "All O:lines of %s have been reset."
msgstr "Todas as O:lines de %s foram redefinidas."
#: ../modules/operserv/os_noop.cpp:71
msgid "SET kills all operators from the given server and prevents operators from opering up on the given server. REVOKE removes this restriction."
msgstr "SET desconecta todos os operadores do servidor informado e impede que operadores se tornem oper nesse servidor. REVOKE remove essa restrição."
