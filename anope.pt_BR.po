msgid "channel {ON|OFF} [ttb [min [percent]]]"
msgstr "canal {ON|OFF} [ttb [mín [porcentagem]]]"
#: ../modules/botserv/bs_kick.cpp:425
#, c-format
msgid "Bot will now kick for caps (they must constitute at least %d characters and %d%% of the entire message), and will place a ban after %d kicks for the same user."
msgstr "O bot irá agora kickar por caps (elas devem constituir pelo menos %d caracteres e %d%% de toda a mensagem) e colocará um ban após %d kicks para o mesmo usuário."
