#: ../include/language.h:117
msgid "Access denied."
msgstr "Acesso negado."
#: ../include/language.h:118
msgid "Invalid expiry time."
msgstr "Tempo de expiração inválido."
#: ../include/language.h:119
msgid "Mask must be in the form user@host."
msgstr "A máscara deve estar na forma user@host."
#: ../include/language.h:120
#, c-format
msgid "Please confirm that you want to drop %s with %s%s%s"
msgstr "Confirme que deseja remover %s com %s%s%s"
#: ../include/language.h:121
msgid "All new accounts must be confirmed by an administrator. Please wait for your registration to be confirmed."
msgstr "Todas as novas contas devem ser confirmadas por um administrador. Aguarde a confirmação do seu registro."
#: ../include/language.h:122
#, c-format
msgid "All new accounts must be confirmed. To confirm your account, type %s."
msgstr "Todas as novas contas devem ser confirmadas. Para confirmar sua conta, digite %s."
#: ../include/language.h:123
msgid "All new accounts must be confirmed. To confirm your account, follow the instructions that were emailed to you."
msgstr "Todas as novas contas devem ser confirmadas. Para confirmar sua conta, siga as instruções que foram enviadas para o seu e-mail."
#: ../include/language.h:124
msgid "Incorrect range specified. The correct syntax is #from-to."
msgstr "Intervalo especificado incorreto. A sintaxe correta é #de-até."
#: ../include/language.h:125
#, c-format
msgid "%s is not a valid email address."
msgstr "%s não é um endereço de e-mail válido."
#: ../include/language.h:126
#, c-format
msgid "Type %s for more information."
msgstr "Digite %s para mais informações."
#: ../include/language.h:127
msgid "does not expire"
msgstr "não expira"
#: ../include/language.h:128
msgid "Password incorrect."
msgstr "Senha incorreta."
#: ../include/language.h:129
msgid "Services are temporarily in read-only mode."
msgstr "Os Serviços estão temporariamente em modo somente leitura."
#: ../include/language.h:130
msgid "Never"
msgstr "Nunca"
#: ../include/language.h:131
msgid "Now"
msgstr "Agora"
#: ../include/language.h:132
msgid "Unknown"
msgstr "Desconhecido"
#: ../include/language.h:133
#, c-format
msgid "The %s command is temporarily unavailable. Please try again later."
msgstr "O comando %s está temporariamente indisponível. Tente novamente mais tarde."
#: ../include/language.h:134
#, c-format
msgid "%s coverage is too wide; Please use a more specific mask."
msgstr "A cobertura de %s é muito ampla; use uma máscara mais específica."
#: ../include/language.h:136
#, c-format
msgid "Bot %s does not exist."
msgstr "Bot %s não existe."
#: ../include/language.h:137
msgid "You must assign a bot to the channel before using this command."
msgstr "Você precisa atribuir um bot ao canal antes de usar este comando."
#: ../include/language.h:138
#, c-format
msgid "Bot is not on channel %s."
msgstr "O bot não está no canal %s."
#: ../include/language.h:140
#, c-format
msgid "You can only have %u access entry on a channel."
msgid_plural "You can only have %u access entries on a channel."
msgstr[0] "Você só pode ter %u entrada de acesso em um canal."
msgstr[1] "Você só pode ter %u entradas de acesso em um canal."
#: ../include/language.h:141
#, c-format
msgid "You can only have %u access entry on a channel, including access entries from other channels."
msgid_plural "You can only have %u access entries on a channel, including access entries from other channels."
msgstr[0] "Você só pode ter %u entrada de acesso em um canal, incluindo entradas de acesso de outros canais."
msgstr[1] "Você só pode ter %u entradas de acesso em um canal, incluindo entradas de acesso de outros canais."
#: ../include/language.h:142
#, c-format
msgid "Access level must be between %d and %d inclusive."
msgstr "O nível de acesso deve estar entre %d e %d, inclusive."
#: ../include/language.h:143
#, c-format
msgid "You cannot add a malformed mask to an access list. Did you mean to add %s instead?"
msgstr "Você não pode adicionar uma máscara malformada a uma lista de acesso. Você quis dizer adicionar %s?"
#: ../include/language.h:144
#, c-format
msgid "%u access entry from other access systems not shown; use %sALL to view all access entries."
msgid_plural "%u access entries from other access systems not shown; use %sALL to view all access entries."
msgstr[0] "%u entrada de acesso de outros sistemas de acesso não exibida; use %sALL para ver todas as entradas de acesso."
msgstr[1] "%u entradas de acesso de outros sistemas de acesso não exibidas; use %sALL para ver todas as entradas de acesso."
#: ../include/language.h:145
#, c-format
msgid "%s matches an except on %s and cannot be banned until the except has been removed."
msgstr "%s corresponde a uma exceção em %s e não pode ser banido até que a exceção seja removida."
#: ../include/language.h:146
#, c-format
msgid "Information about channel %s:"
msgstr "Informações sobre o canal %s:"
#: ../include/language.h:147
#, c-format
msgid "You have already exceeded your limit of %d channels."
msgstr "Você já excedeu o limite de %d canais."
#: ../include/language.h:148
#, c-format
msgid "You have already reached your limit of %d channels."
msgstr "Você já atingiu o limite de %d canais."
#: ../include/language.h:149
msgid "You are not permitted to be on this channel."
msgstr "Você não tem permissão para estar neste canal."
#: ../include/language.h:150
#, c-format
msgid "%s for %s set to %s."
msgstr "%s de %s definido para %s."
#: ../include/language.h:151
#, c-format
msgid "%s syntax is invalid."
msgstr "A sintaxe de %s é inválida."
#: ../include/language.h:152
#, c-format
msgid "%s for %s unset."
msgstr "%s de %s removido."
#: ../include/language.h:153
msgid "Please use the symbol of # when attempting to register."
msgstr "Use o símbolo # ao tentar registrar."
#: ../include/language.h:154
#, c-format
msgid "Channel %s is not a valid channel."
msgstr "O canal %s não é um canal válido."
#: ../include/language.h:155
#, c-format
msgid "Channel %s doesn't exist."
msgstr "O canal %s não existe."
#: ../include/language.h:156
#, c-format
msgid "Channel %s isn't registered."
msgstr "O canal %s não está registrado."
#: ../include/language.h:157
#, c-format
msgid "Channel %s is currently suspended."
msgstr "O canal %s está suspenso."
#: ../include/language.h:159
msgid "Your IRCd does not support vidents. If this is incorrect please report this as a possible bug."
msgstr "Seu IRCd não suporta vidents. Se isso estiver incorreto, reporte isso como um possível erro."
#: ../include/language.h:160
msgid "Please contact an Operator to get a vhost assigned to this nick."
msgstr "Entre em contato com um Operador para que um vhost seja atribuído a este nick."
#: ../include/language.h:161
msgid "A vhost must be in the format of a valid hostname."
msgstr "Um vhost deve estar no formato de um hostname válido."
#: ../include/language.h:162
#, c-format
msgid "Error! The vhost is too long, please use a hostname shorter than %zu characters."
msgstr "Erro! O vhost é muito longo, use um hostname com menos de %zu caracteres."
#: ../include/language.h:163
msgid "A vident must be in the format of a valid ident."
msgstr "Um vident deve estar no formato de um ident válido."
#: ../include/language.h:164
#, c-format
msgid "Error! The vident is too long, please use an ident shorter than %zu characters."
msgstr "Erro! O vident é muito longo, use um ident com menos de %zu caracteres."
#: ../include/language.h:166
msgid "You have no memos."
msgstr "Você não tem memos."
#: ../include/language.h:167
msgid "You have no new memos."
msgstr "Você não tem novos memos."
#: ../include/language.h:168
#, c-format
msgid "You have a new memo from %s. Type %s%zu to read it."
msgstr "Você tem um novo memo de %s. Digite %s%zu para lê-lo."
#: ../include/language.h:169
#, c-format
msgid "There is a new memo on channel %s. Type %s%s%zu to read it."
msgstr "Há um novo memo no canal %s. Digite %s%s%zu para lê-lo."
#: ../include/language.h:170
#, c-format
msgid "%s has no memos."
msgstr "%s não tem memos."
#: ../include/language.h:171
#, c-format
msgid "%s has no new memos."
msgstr "%s não tem novos memos."
#: ../include/language.h:173
#, c-format
msgid "Nickname %s is already registered!"
msgstr "Nickname %s já está registrado!"
#: ../include/language.h:174
#, c-format
msgid "Nickname %s may not be registered."
msgstr "Nickname %s não pode ser registrado."
#: ../include/language.h:175
msgid "You must be logged into an account to use that command."
msgstr "Você precisa estar conectado a uma conta para usar esse comando."
#: ../include/language.h:176
#, c-format
msgid "The new display is now %s."
msgstr "O novo display agora é %s."
#: ../include/language.h:177
#, c-format
msgid "Nick %s isn't currently in use."
msgstr "O nick %s não está em uso."
#: ../include/language.h:178
#, c-format
msgid "%s is not currently on channel %s."
msgstr "%s não está no canal %s."
#: ../include/language.h:179
#, c-format
msgid "Nick %s isn't registered."
msgstr "Nick %s não está registrado."
#: ../include/language.h:180
#, c-format
msgid "Nick %s is currently suspended."
msgstr "O nick %s está suspenso."
#: ../include/modules/global/service.h:17
msgid "You do not have any messages queued and did not specify a message to send."
msgstr "Você não tem mensagens na fila e não especificou nenhuma mensagem para enviar."
#: ../include/modules/global/service.h:18
msgid "You can not send a single message while you have messages queued."
msgstr "Você não pode enviar uma única mensagem enquanto tiver mensagens na fila."
#: ../modules/botserv/botserv.cpp:142
#, c-format
msgid "%s allows you to execute \"fantasy\" commands in the channel. Fantasy commands are commands that can be executed from messaging a channel, and provide a more convenient way to execute commands. Commands that require a channel as a parameter will automatically have that parameter given."
msgstr "%s permite que você execute comandos \"fantasia\" no canal. Os comandos fantasia são comandos que podem ser executados enviando uma mensagem para o canal e oferecem uma forma mais conveniente de executar comandos. Os comandos que exigem um canal como parâmetro terão esse parâmetro preenchido automaticamente."
#: ../modules/botserv/botserv.cpp:154
#, c-format
msgid "Fantasy commands may be prefixed with one of the following fantasy prefixes: %s"
msgstr "Os comandos fantasia podem ser prefixados com um dos seguintes prefixos fantasia: %s"
#: ../modules/botserv/botserv.cpp:158
msgid "Available commands are:"
msgstr "Os comandos disponíveis são:"
#: ../modules/botserv/botserv.cpp:163
#, c-format
msgid "%s allows you to have a bot on your own channel. It has been created for users that can't host or configure a bot, or for use on networks that don't allow user bots. Available commands are listed below; to use them, type %scommand. For more information on a specific command, type %scommand."
msgstr "%s permite que você tenha um bot no seu próprio canal. Ele foi criado para usuários que não conseguem hospedar ou configurar um bot, ou para uso em redes que não permitem bots de usuários. Os comandos disponíveis estão listados abaixo; para usá-los, digite %scomando. Para mais informações sobre um comando específico, digite %scomando."
#: ../modules/botserv/botserv.cpp:187
#, c-format
msgid "Bot will join a channel whenever there is at least %d user(s) on it."
msgstr "O bot entrará no canal sempre que houver pelo menos %d usuário(s) nele."
#: ../modules/botserv/botserv.cpp:194
#, c-format
msgid "Additionally, if fantasy is enabled fantasy commands can be executed by prefixing the command name with one of the following fantasy prefixes: %s"
msgstr "Além disso, se o fantasia estiver habilitado, os comandos fantasia podem ser executados prefixando o nome do comando com um dos seguintes prefixos fantasia: %s"
#: ../modules/botserv/bs_assign.cpp:23
msgid "Assign a bot to a channel"
msgstr "Atribuir um bot a um canal"
#: ../modules/botserv/bs_assign.cpp:24 ../modules/chanserv/cs_set.cpp:280
msgid "channel nick"
msgstr "canal nick"
#: ../modules/botserv/bs_assign.cpp:67 ../modules/botserv/bs_assign.cpp:268
#, c-format
msgid "Bot %s is already assigned to channel %s."
msgstr "O bot %s já está atribuído ao canal %s."
#: ../modules/botserv/bs_assign.cpp:75 ../modules/botserv/bs_assign.cpp:273
#, c-format
msgid "Bot %s has been assigned to %s."
msgstr "O bot %s foi atribuído a %s."
#: ../modules/botserv/bs_assign.cpp:83
msgid "Assigns the specified bot to a channel. You can then configure the bot for the channel so it fits your needs."
msgstr "Atribui o bot especificado a um canal. Depois disso você pode configurar o bot para o canal conforme suas necessidades."
#: ../modules/botserv/bs_assign.cpp:90
msgid "Assigns the OperServ bot to #opers."
msgstr "Atribui o bot OperServ ao #opers."
#: ../modules/botserv/bs_assign.cpp:104
msgid "Unassign a bot from a channel"
msgstr "Remover a atribuição de um bot de um canal"
#: ../modules/botserv/bs_assign.cpp:105
#: ../modules/chanserv/cs_fantasy_top.cpp:44
#: ../modules/chanserv/cs_fantasy_top.cpp:57
#: ../modules/chanserv/cs_getkey.cpp:24 ../modules/chanserv/cs_info.cpp:24
#: ../modules/chanserv/cs_log.cpp:122 ../modules/chanserv/cs_suspend.cpp:169
#: ../modules/chanserv/cs_sync.cpp:24
msgid "channel"
msgstr "canal"
#: ../modules/botserv/bs_assign.cpp:138
msgid "You cannot unassign bots while persist is set on the channel."
msgstr "Você não pode remover a atribuição de bots enquanto a persistência estiver definida no canal."
#: ../modules/botserv/bs_assign.cpp:146
#, c-format
msgid "There is no bot assigned to %s anymore."
msgstr "Não há mais nenhum bot atribuído a %s."
#: ../modules/botserv/bs_assign.cpp:154
msgid "Unassigns a bot from a channel. When you use this command, the bot won't join the channel anymore. However, bot configuration for the channel is kept, so you will always be able to reassign a bot later without having to reconfigure it entirely."
msgstr "Remove a atribuição de um bot de um canal. Quando você usa este comando, o bot deixa de entrar no canal. No entanto, a configuração do bot para o canal é mantida, de modo que você sempre poderá reatribuir um bot mais tarde sem precisar reconfigurá-lo por completo."
#: ../modules/botserv/bs_assign.cpp:163
msgid "Unassigns a previously assigned bot from #opers."
msgstr "Remove a atribuição de um bot previamente atribuído a #opers."
#: ../modules/botserv/bs_assign.cpp:177
msgid "Prevent a bot from being assigned to a channel"
msgstr "Impedir que um bot seja atribuído a um canal"
#: ../modules/botserv/bs_assign.cpp:178 ../modules/fantasy.cpp:24
#: ../modules/greet.cpp:24
msgid "channel {ON|OFF}"
msgstr "canal {ON|OFF}"
#: ../modules/botserv/bs_assign.cpp:205
#, c-format
msgid "No-bot mode is now on on channel %s."
msgstr "O modo sem bot está agora ativado no canal %s."
#: ../modules/botserv/bs_assign.cpp:212
#, c-format
msgid "No-bot mode is now off on channel %s."
msgstr "O modo sem bot está agora desativado no canal %s."
#: ../modules/botserv/bs_assign.cpp:223
msgid "This option makes a channel unassignable. If a bot is already assigned to the channel, it is unassigned automatically when you enable it."
msgstr "Esta opção impede a atribuição de bots ao canal. Se um bot já estiver atribuído ao canal, ele é removido automaticamente quando você ativa a opção."
#: ../modules/botserv/bs_assign.cpp:279
msgid "No bot"
msgstr "Sem bot"
#: ../modules/botserv/bs_badwords.cpp:218
#: ../modules/botserv/bs_badwords.cpp:308
#, c-format
msgid "No matching entries on %s bad words list."
msgstr "Nenhuma entrada correspondente na lista de palavrões de %s."
#: ../modules/botserv/bs_badwords.cpp:222
#, c-format
msgid "Deleted %s from %s bad words list."
msgstr "%s removido da lista de palavrões de %s."
#: ../modules/botserv/bs_badwords.cpp:226
#, c-format
msgid "Deleted %d entry from %s bad words list."
msgid_plural "Deleted %d entries from %s bad words list."
msgstr[0] "%d entrada removida da lista de palavrões de %s."
msgstr[1] "%d entradas removidas da lista de palavrões de %s."
#: ../modules/botserv/bs_badwords.cpp:253 ../modules/chanserv/cs_access.cpp:526
#: ../modules/chanserv/cs_access.cpp:546 ../modules/chanserv/cs_akick.cpp:555
#: ../modules/chanserv/cs_akick.cpp:575 ../modules/chanserv/cs_entrymsg.cpp:128
#: ../modules/chanserv/cs_flags.cpp:358 ../modules/chanserv/cs_log.cpp:143
