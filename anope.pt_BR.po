#: ../modules/chanserv/cs_seen.cpp:349
msgid "Checks for the last time nick was seen joining, leaving, or changing nick on the network and tells you when and, depending on channel or user settings, where it was."
msgstr "Verifica a última vez em que nick foi visto entrando, saindo ou mudando de nick na rede e informa quando isso aconteceu e, dependendo das configurações do canal ou do usuário, onde aconteceu."
#: ../modules/chanserv/cs_set.cpp:24
msgid "Set channel options and information"
msgstr "Definir as opções e as informações do canal"
#: ../modules/chanserv/cs_set.cpp:25
msgid "option channel parameters"
msgstr "opção canal parâmetros"
#: ../modules/chanserv/cs_set.cpp:38
msgid "Allows the channel founder to set various channel options and other information.\n\nAvailable options:"
msgstr "Permite que o fundador do canal defina várias opções do canal e outras informações.\n\nOpções disponíveis:"
#: ../modules/chanserv/cs_set.cpp:82
msgid "Should services automatically give status to users"
msgstr "Se os Serviços devem conceder status automaticamente aos usuários"
#: ../modules/chanserv/cs_set.cpp:116
#, c-format
msgid "Services will now automatically give modes to users in %s."
msgstr "A partir de agora os Serviços concederão modos automaticamente aos usuários em %s."
#: ../modules/chanserv/cs_set.cpp:122
#, c-format
msgid "Services will no longer automatically give modes to users in %s."
msgstr "A partir de agora os Serviços deixarão de conceder modos automaticamente aos usuários em %s."
#: ../modules/chanserv/cs_set.cpp:133
#, c-format
msgid "Enables or disables %s's autoop feature for a channel. When disabled, users who join the channel will not automatically gain any status from %s."
msgstr "Ativa ou desativa o recurso autoop do %s para um canal. Quando desativado, os usuários que entram no canal não ganharão automaticamente nenhum status do %s."
#: ../modules/chanserv/cs_set.cpp:149
msgid "Set how services make bans on the channel"
msgstr "Definir como os Serviços aplicam bans no canal"
#: ../modules/chanserv/cs_set.cpp:150
msgid "channel bantype"
msgstr "canal tipo-de-ban"
#: ../modules/chanserv/cs_set.cpp:182
#, c-format
msgid "%s is not a valid ban type."
msgstr "%s não é um tipo de ban válido."
#: ../modules/chanserv/cs_set.cpp:188
#, c-format
msgid "Ban type for channel %s is now #%d."
msgstr "O tipo de ban do canal %s é agora #%d."
#: ../modules/chanserv/cs_set.cpp:196
msgid "Sets the ban type that will be used by services whenever they need to ban someone from your channel.\n\nBantype is a number between 0 and 3 that means:\n\n0: ban in the form *!user@host\n1: ban in the form *!*user@host\n2: ban in the form *!*@host\n3: ban in the form *!*user@*.domain"
msgstr "Define o tipo de ban que será usado pelos Serviços sempre que precisarem banir alguém do seu canal.\n\nO tipo de ban é um número entre 0 e 3 que significa:\n\n0: ban no formato *!user@host\n1: ban no formato *!*user@host\n2: ban no formato *!*@host\n3: ban no formato *!*user@*.domain"
#: ../modules/chanserv/cs_set.cpp:216
msgid "Set the channel description"
msgstr "Definir a descrição do canal"
#: ../modules/chanserv/cs_set.cpp:251
#, c-format
msgid "Description of %s changed to %s."
msgstr "A descrição de %s foi alterada para %s."
#: ../modules/chanserv/cs_set.cpp:257
#, c-format
msgid "Description of %s unset."
msgstr "A descrição de %s foi removida."
#: ../modules/chanserv/cs_set.cpp:266
msgid "Sets the description for the channel, which shows up with the LIST and INFO commands."
msgstr "Define a descrição do canal, que aparece nos comandos LIST e INFO."
#: ../modules/chanserv/cs_set.cpp:279
msgid "Set the founder of a channel"
msgstr "Definir o fundador de um canal"
#: ../modules/chanserv/cs_set.cpp:326
#, c-format
msgid "%s has too many channels registered."
msgstr "%s tem canais registrados demais."
#: ../modules/chanserv/cs_set.cpp:334
#, c-format
msgid "Founder of %s changed to %s."
msgstr "O fundador de %s foi alterado para %s."
#: ../modules/chanserv/cs_set.cpp:342
msgid "Changes the founder of a channel. The new nickname must be a registered one."
msgstr "Altera o fundador de um canal. O novo nickname precisa estar registrado."
#: ../modules/chanserv/cs_set.cpp:355
msgid "Retain modes when channel is not in use"
msgstr "Manter os modos quando o canal não está em uso"
#: ../modules/chanserv/cs_set.cpp:389
#: ../modules/nickserv/ns_set_keepmodes.cpp:53
#, c-format
msgid "Keep modes for %s is now on."
msgstr "A opção manter modos de %s está agora ativada."
#: ../modules/chanserv/cs_set.cpp:397
#: ../modules/nickserv/ns_set_keepmodes.cpp:59
#, c-format
msgid "Keep modes for %s is now off."
msgstr "A opção manter modos de %s está agora desativada."
#: ../modules/chanserv/cs_set.cpp:409
msgid "Enables or disables keepmodes for the given channel. If keep modes is enabled, services will remember modes set on the channel and attempt to re-set them the next time the channel is created."
msgstr "Ativa ou desativa a opção manter modos para o canal informado. Se a manutenção de modos estiver habilitada, os Serviços lembrarão dos modos definidos no canal e tentarão redefini-los na próxima vez que o canal for criado."
#: ../modules/chanserv/cs_set.cpp:423
msgid "Regulate the use of critical commands"
msgstr "Regular o uso de comandos críticos"
#: ../modules/chanserv/cs_set.cpp:457
#, c-format
msgid "Peace option for %s is now on."
msgstr "A opção peace de %s está agora ativada."
#: ../modules/chanserv/cs_set.cpp:463
#, c-format
msgid "Peace option for %s is now off."
msgstr "A opção peace de %s está agora desativada."
#: ../modules/chanserv/cs_set.cpp:474
#, c-format
msgid "Enables or disables the peace option for a channel. When peace is set, a user won't be able to kick, ban or remove a channel status of a user that has a level superior or equal to theirs via %s commands."
msgstr "Ativa ou desativa a opção peace para um canal. Quando peace está definido, um usuário não poderá kickar, banir nem remover um status de canal de um usuário cujo nível seja superior ou igual ao seu por meio dos comandos %s."
#: ../modules/chanserv/cs_set.cpp:497
msgid "Set the channel as permanent"
msgstr "Definir o canal como permanente"
#: ../modules/chanserv/cs_set.cpp:554 ../modules/chanserv/cs_set.cpp:597
msgid "ChanServ is required to enable persist on this network."
msgstr "O ChanServ é necessário para habilitar a persistência nesta rede."
#: ../modules/chanserv/cs_set.cpp:568
#, c-format
msgid "Channel %s is now persistent."
msgstr "O canal %s agora é persistente."
#: ../modules/chanserv/cs_set.cpp:607
#, c-format
msgid "Channel %s is no longer persistent."
msgstr "O canal %s não é mais persistente."
#: ../modules/chanserv/cs_set.cpp:620
#, c-format
msgid "Enables or disables the persistent channel setting. When persistent is set, the service bot will remain in the channel when it has emptied of users. \n\nIf your IRCd does not have a permanent (persistent) channel mode you must have a service bot in your channel to set persist on, and it can not be unassigned while persist is on.\n\nIf this network does not have %s enabled and does not have a permanent channel mode, %s will join your channel when you set persist on (and leave when it has been set off).\n\nIf your IRCd has a permanent (persistent) channel mode and it is set or unset (for any reason, including MODE LOCK), persist is automatically set and unset for the channel as well. Additionally, services will set or unset this mode when you set persist on or off."
msgstr "Ativa ou desativa a configuração de canal persistente. Quando a persistência está definida, o bot de serviço permanecerá no canal mesmo quando ele ficar sem usuários. \n\nSe o seu IRCd não tiver um modo de canal permanente (persistente), você precisa ter um bot de serviço no seu canal para habilitar a persistência, e ele não pode ser removido enquanto a persistência estiver ativa.\n\nSe esta rede não tiver %s habilitado e não tiver um modo de canal permanente, o %s entrará no seu canal quando você habilitar a persistência (e sairá quando ela for desabilitada).\n\nSe o seu IRCd tiver um modo de canal permanente (persistente) e ele for definido ou removido (por qualquer motivo, incluindo MODE LOCK), a persistência também será automaticamente definida e removida para o canal. Além disso, os Serviços definirão ou removerão esse modo quando você habilitar ou desabilitar a persistência."
#: ../modules/chanserv/cs_set.cpp:653
msgid "Restrict access to the channel"
msgstr "Restringir o acesso ao canal"
#: ../modules/chanserv/cs_set.cpp:687
#, c-format
msgid "Restricted access option for %s is now on."
msgstr "A opção de acesso restrito de %s está agora ativada."
#: ../modules/chanserv/cs_set.cpp:693
#, c-format
msgid "Restricted access option for %s is now off."
msgstr "A opção de acesso restrito de %s está agora desativada."
#: ../modules/chanserv/cs_set.cpp:704
msgid "Enables or disables the restricted access option for a channel. When restricted access is set, users not on the access list will instead be kicked and banned from the channel."
msgstr "Ativa ou desativa a opção acesso restrito de um canal. Quando acesso restrito está definido, os usuários que não estiverem na lista de acesso serão kickados e banidos do canal."
#: ../modules/chanserv/cs_set.cpp:718
msgid "Stricter control of channel founder status"
msgstr "Controle mais rigoroso do status de fundador do canal"
#: ../modules/chanserv/cs_set.cpp:752
#, c-format
msgid "Secure founder option for %s is now on."
msgstr "A opção de fundador seguro de %s está agora ativada."
#: ../modules/chanserv/cs_set.cpp:758
#, c-format
msgid "Secure founder option for %s is now off."
msgstr "A opção de fundador seguro de %s está agora desativada."
#: ../modules/chanserv/cs_set.cpp:769
msgid "Enables or disables the secure founder option for a channel. When secure founder is set, only the real founder will be able to drop the channel, change its founder and its successor, and not those who have founder level access through the access/qop command."
msgstr "Ativa ou desativa a opção fundador seguro de um canal. Quando fundador seguro está definido, somente o verdadeiro fundador poderá remover o canal, alterar seu fundador e seu sucessor, e não aqueles que têm acesso de nível de fundador por meio do comando access/qop."
#: ../modules/chanserv/cs_set.cpp:785
msgid "Stricter control of chanop status"
msgstr "Controle mais rigoroso do status de op"
#: ../modules/chanserv/cs_set.cpp:819
#, c-format
msgid "Secure ops option for %s is now on."
msgstr "A opção de ops seguros de %s está agora ativada."
#: ../modules/chanserv/cs_set.cpp:825
#, c-format
msgid "Secure ops option for %s is now off."
msgstr "A opção de ops seguros de %s está agora desativada."
#: ../modules/chanserv/cs_set.cpp:836
msgid "Enables or disables the secure ops option for a channel. When secure ops is set, users who are not on the access list will not be allowed channel operator status."
msgstr "Ativa ou desativa a opção ops seguros de um canal. Quando ops seguros está definido, os usuários que não estiverem na lista de acesso não poderão receber status de operador de canal."
#: ../modules/chanserv/cs_set.cpp:850
msgid "Sign kicks that are done with the KICK command"
msgstr "Assinar os kicks feitos com o comando KICK"
#: ../modules/chanserv/cs_set.cpp:851
msgid "channel {ON | LEVEL | OFF}"
msgstr "canal {ON | LEVEL | OFF}"
#: ../modules/chanserv/cs_set.cpp:884
#, c-format
msgid "Signed kick option for %s is now on."
msgstr "A opção de kick assinado de %s está agora ativada."
#: ../modules/chanserv/cs_set.cpp:891
#, c-format
msgid "Signed kick option for %s is now on, but depends of the level of the user that is using the command."
msgstr "A opção de kick assinado de %s está agora ativada, mas depende do nível do usuário que está usando o comando."
#: ../modules/chanserv/cs_set.cpp:899
#, c-format
msgid "Signed kick option for %s is now off."
msgstr "A opção de kick assinado de %s está agora desativada."
#: ../modules/chanserv/cs_set.cpp:911
msgid "Enables or disables signed kicks for a channel. When SIGNKICK is set, kicks issued with the KICK command will have the nick that used the command in their reason.\n\nIf you use LEVEL, those who have a level that is superior or equal to the SIGNKICK level on the channel won't have their kicks signed."
msgstr "Ativa ou desativa kicks assinados de um canal. Quando SIGNKICK está definido, os kicks emitidos com o comando KICK terão no motivo o nick que usou o comando.\n\nSe você usar LEVEL, os usuários que tiverem no canal um nível superior ou igual ao nível SIGNKICK não terão seus kicks assinados."
#: ../modules/chanserv/cs_set.cpp:930
msgid "Set the successor for a channel"
msgstr "Definir o sucessor de um canal"
#: ../modules/chanserv/cs_set.cpp:988
#, c-format
msgid "%s cannot be the successor on channel %s as they are the founder."
msgstr "%s não pode ser o sucessor no canal %s porque já é o fundador."
#: ../modules/chanserv/cs_set.cpp:1001
#, c-format
msgid "Successor for %s changed to %s."
msgstr "O sucessor de %s foi alterado para %s."
#: ../modules/chanserv/cs_set.cpp:1003
#, c-format
msgid "Successor for %s unset."
msgstr "O sucessor de %s foi removido."
#: ../modules/chanserv/cs_set.cpp:1011
msgid "Changes the successor of a channel. If the founder's nickname expires or is dropped while the channel is still registered, the successor will become the new founder of the channel. The successor's nickname must be a registered one. If there's no successor set, then the first nickname on the access list (with the highest access, if applicable) will become the new founder, but if the access list is empty, the channel will be dropped."
msgstr "Altera o sucessor de um canal. Se o nickname do fundador expirar ou for removido enquanto o canal ainda estiver registrado, o sucessor se tornará o novo fundador do canal. O nickname do sucessor precisa estar registrado. Se não houver sucessor definido, o primeiro nickname da lista de acesso (com o acesso mais alto, se aplicável) se tornará o novo fundador, mas se a lista de acesso estiver vazia, o canal será removido."
#: ../modules/chanserv/cs_set.cpp:1026
#, c-format
msgid "Note, however, if the successor already has too many channels registered (%u), they will not be able to become the new founder and it will be as if the channel had no successor set."
msgstr "Observe, porém, que se o sucessor já tiver canais registrados demais (%u), ele não poderá se tornar o novo fundador e será como se o canal não tivesse sucessor definido."
#: ../modules/chanserv/cs_set.cpp:1043
msgid "Prevent the channel from expiring"
msgstr "Impedir que o canal expire"
#: ../modules/chanserv/cs_set.cpp:1072
#, c-format
msgid "Channel %s will not expire."
msgstr "O canal %s não irá expirar."
#: ../modules/chanserv/cs_set.cpp:1078
#, c-format
msgid "Channel %s will expire."
msgstr "O canal %s irá expirar."
#: ../modules/chanserv/cs_set.cpp:1089
msgid "Sets whether the given channel will expire. Setting this to ON prevents the channel from expiring."
msgstr "Define se o canal informado irá expirar. Definir como ON impede que o canal expire."
#: ../modules/chanserv/cs_set.cpp:1317
msgid "Peace"
msgstr "Peace"
#: ../modules/chanserv/cs_set.cpp:1319
msgid "Restricted access"
msgstr "Acesso restrito"
#: ../modules/chanserv/cs_set.cpp:1321
msgid "Secure founder"
msgstr "Fundador seguro"
#: ../modules/chanserv/cs_set.cpp:1323
msgid "Secure ops"
msgstr "Ops seguros"
#: ../modules/chanserv/cs_set.cpp:1325
msgid "Signed kicks"
msgstr "Kicks assinados"
#: ../modules/chanserv/cs_set.cpp:1327
msgid "Persistent"
msgstr "Persistente"
#: ../modules/chanserv/cs_set.cpp:1329 ../modules/nickserv/ns_set.cpp:312
msgid "No expiry"
msgstr "Sem expiração"
#: ../modules/chanserv/cs_set.cpp:1331
#: ../modules/nickserv/ns_set_keepmodes.cpp:209
msgid "Keep modes"
msgstr "Manter modos"
#: ../modules/chanserv/cs_set.cpp:1333
msgid "No auto-op"
msgstr "Sem auto-op"
#: ../modules/chanserv/cs_set_misc.cpp:231
#: ../modules/nickserv/ns_set_misc.cpp:261
#: ../modules/nickserv/ns_set_misc.cpp:289
msgid "value"
msgstr "valor"
#: ../modules/chanserv/cs_set_misc.cpp:238
#, c-format
msgid "channel [%s]"
msgstr "canal [%s]"
#: ../modules/chanserv/cs_status.cpp:24
msgid "Find a user's status on a channel"
msgstr "Encontrar o status de um usuário em um canal"
#: ../modules/chanserv/cs_status.cpp:25
msgid "channel [user]"
msgstr "canal [usuário]"
#: ../modules/chanserv/cs_status.cpp:56
#, c-format
msgid "%s is a super administrator."
msgstr "%s é um super administrador."
#: ../modules/chanserv/cs_status.cpp:58
#, c-format
msgid "%s is the founder of %s."
msgstr "%s é o fundador de %s."
#: ../modules/chanserv/cs_status.cpp:60
#, c-format
msgid "%s has no access on %s."
msgstr "%s não tem acesso em %s."
#: ../modules/chanserv/cs_status.cpp:63
#, c-format
msgid "Access for %s on %s:"
msgstr "Acesso de %s em %s:"
#: ../modules/chanserv/cs_status.cpp:74
#, c-format
msgid "%s matches access entry %s, which has privilege %s."
msgstr "%s corresponde à entrada de acesso %s, que tem o privilégio %s."
#: ../modules/chanserv/cs_status.cpp:81
#, c-format
msgid "%s matches access entry %s (from entry %s), which has privilege %s."
msgstr "%s corresponde à entrada de acesso %s (da entrada %s), que tem o privilégio %s."
#: ../modules/chanserv/cs_status.cpp:95
#, c-format
msgid "%s is on the auto kick list of %s (%s)."
msgstr "%s está na lista de autokick de %s (%s)."
#: ../modules/chanserv/cs_status.cpp:101
#, c-format
msgid "%s matches auto kick entry %s on %s (%s)."
msgstr "%s corresponde à entrada de autokick %s em %s (%s)."
#: ../modules/chanserv/cs_status.cpp:113
msgid "This command tells you what a users access is on a channel and what access entries, if any, they match. Additionally it will tell you of any auto kick entries they match. Usage of this command is limited to users who have the ability to modify access entries on the channel."
msgstr "Este comando informa qual é o acesso de um usuário em um canal e a quais entradas de acesso, se houver, ele corresponde. Além disso, informa também as entradas de autokick às quais ele corresponde. O uso deste comando é restrito aos usuários que podem alterar as entradas de acesso do canal."
#: ../modules/chanserv/cs_suspend.cpp:72
msgid "Prevent a channel from being used preserving channel data and settings"
msgstr "Impedir que um canal seja usado, preservando os dados e as configurações do canal"
#: ../modules/chanserv/cs_suspend.cpp:73
msgid "channel [+expiry] [reason]"
msgstr "canal [+expiração] [motivo]"
#: ../modules/chanserv/cs_suspend.cpp:94 ../modules/nickserv/ns_suspend.cpp:103
#, c-format
msgid "%s is already suspended."
msgstr "%s já está suspenso."
#: ../modules/chanserv/cs_suspend.cpp:135
msgid "This channel has been suspended."
msgstr "Este canal foi suspenso."
#: ../modules/chanserv/cs_suspend.cpp:139
#, c-format
msgid "Channel %s is now suspended."
msgstr "O canal %s está agora suspenso."
#: ../modules/chanserv/cs_suspend.cpp:149
msgid "Disallows anyone from using the given channel. May be cancelled by using the UNSUSPEND command to preserve all previous channel data/settings. If an expiry is given the channel will be unsuspended after that period of time, else the default expiry from the configuration is used.\n\nReason may be required on certain networks."
msgstr "Impede que qualquer pessoa use o canal informado. Pode ser cancelado usando o comando UNSUSPEND, preservando todos os dados e configurações anteriores do canal. Se uma expiração for informada, o canal deixará de estar suspenso após esse período; caso contrário, é usada a expiração padrão da configuração.\n\nO motivo pode ser obrigatório em algumas redes."
#: ../modules/chanserv/cs_suspend.cpp:168
msgid "Release a suspended channel"
msgstr "Liberar um canal suspenso"
#: ../modules/chanserv/cs_suspend.cpp:189
#, c-format
msgid "Channel %s isn't suspended."
msgstr "O canal %s não está suspenso."
#: ../modules/chanserv/cs_suspend.cpp:197
#, c-format
msgid "Channel %s is now released."
msgstr "O canal %s foi liberado."
#: ../modules/chanserv/cs_suspend.cpp:207
msgid "Releases a suspended channel. All data and settings are preserved from before the suspension."
msgstr "Libera um canal suspenso. Todos os dados e as configurações de antes da suspensão são preservados."
#: ../modules/chanserv/cs_suspend.cpp:266 ../modules/nickserv/ns_list.cpp:113
#: ../modules/nickserv/ns_suspend.cpp:271
msgid "Suspended"
msgstr "Suspenso"
#: ../modules/chanserv/cs_suspend.cpp:266
msgid "This channel is suspended."
msgstr "Este canal está suspenso."
#: ../modules/chanserv/cs_suspend.cpp:268
#: ../modules/nickserv/ns_suspend.cpp:273
msgid "Suspended by"
msgstr "Suspenso por"
#: ../modules/chanserv/cs_suspend.cpp:270
#: ../modules/nickserv/ns_suspend.cpp:275
msgid "Suspend reason"
msgstr "Motivo da suspensão"
#: ../modules/chanserv/cs_suspend.cpp:272
#: ../modules/nickserv/ns_suspend.cpp:277
msgid "Suspended on"
msgstr "Suspenso em"
#: ../modules/chanserv/cs_suspend.cpp:274
#: ../modules/nickserv/ns_suspend.cpp:279
msgid "Suspension expires"
msgstr "A suspensão expira"
#: ../modules/chanserv/cs_suspend.cpp:307
msgid "This channel may not be used."
msgstr "Este canal não pode ser usado."
#: ../modules/chanserv/cs_sync.cpp:23
msgid "Sync users channel modes"
msgstr "Sincronizar os modos de canal dos usuários"
#: ../modules/chanserv/cs_sync.cpp:45
#, c-format
msgid "All user modes on %s have been synced."
msgstr "Todos os modos de usuário em %s foram sincronizados."
#: ../modules/chanserv/cs_sync.cpp:54
msgid "Syncs all modes set on users on the channel with the modes they should have based on their access."
msgstr "Sincroniza todos os modos definidos nos usuários do canal com os modos que eles deveriam ter de acordo com o seu acesso."
#: ../modules/chanserv/cs_topic.cpp:24
msgid "Retain topic when channel is not in use"
msgstr "Manter o tópico quando o canal não está em uso"
#: ../modules/chanserv/cs_topic.cpp:58
#, c-format
msgid "Topic retention option for %s is now on."
msgstr "A opção de retenção de tópico de %s está agora ativada."
#: ../modules/chanserv/cs_topic.cpp:64
#, c-format
msgid "Topic retention option for %s is now off."
msgstr "A opção de retenção de tópico de %s está agora desativada."
#: ../modules/chanserv/cs_topic.cpp:75
#, c-format
msgid "Enables or disables the topic retention option for a channel. When %s is set, the topic for the channel will be remembered by %s even after the last user leaves the channel, and will be restored the next time the channel is created."
msgstr "Ativa ou desativa a opção retenção de tópico de um canal. Quando %s está definido, o tópico do canal será lembrado pelo %s mesmo depois que o último usuário sair do canal e será restaurado na próxima vez que o canal for criado."
#: ../modules/chanserv/cs_topic.cpp:106
#, c-format
msgid "Topic lock option for %s is now on."
msgstr "A opção de bloqueio de tópico de %s está agora ativada."
#: ../modules/chanserv/cs_topic.cpp:123
#, c-format
msgid "Topic lock option for %s is now off."
msgstr "A opção de bloqueio de tópico de %s está agora desativada."
#: ../modules/chanserv/cs_topic.cpp:162
msgid "Manipulate the topic of the specified channel"
msgstr "Manipular o tópico do canal especificado"
#: ../modules/chanserv/cs_topic.cpp:163
msgid "channel [SET] [topic]"
msgstr "canal [SET] [tópico]"
#: ../modules/chanserv/cs_topic.cpp:164
msgid "channel APPEND topic"
msgstr "canal APPEND tópico"
#: ../modules/chanserv/cs_topic.cpp:165
msgid "channel PREPEND topic"
msgstr "canal PREPEND tópico"
#: ../modules/chanserv/cs_topic.cpp:166
msgid "channel [UNLOCK|LOCK]"
msgstr "canal [UNLOCK|LOCK]"
#: ../modules/chanserv/cs_topic.cpp:210
msgid "Allows manipulating the topic of the specified channel. The SET command changes the topic of the channel to the given topic or unsets the topic if no topic is given. The APPEND command appends the given topic to the existing topic. \n\nLOCK and UNLOCK may be used to enable and disable topic lock. When topic lock is set, the channel topic will be unchangeable by users who do not have the TOPIC privilege."
msgstr "Permite manipular o tópico do canal especificado. O comando SET altera o tópico do canal para o tópico informado ou remove o tópico se nenhum for informado. O comando APPEND anexa o tópico informado ao tópico existente. \n\nLOCK e UNLOCK podem ser usados para habilitar e desabilitar o bloqueio de tópico. Quando o bloqueio de tópico está definido, o tópico do canal não poderá ser alterado por usuários que não tenham o privilégio TOPIC."
#: ../modules/chanserv/cs_topic.cpp:275
msgid "Topic retention"
msgstr "Retenção de tópico"
#: ../modules/chanserv/cs_topic.cpp:277
msgid "Topic lock"
msgstr "Bloqueio de tópico"
