msgid "pattern [SUSPENDED] [NOEXPIRE]"
msgstr "padrão [SUSPENDED] [NOEXPIRE]"
#: ../modules/chanserv/cs_list.cpp:49
msgid "To search for channels starting with #, search for the channel name without the #-sign prepended (anope instead of #anope)."
msgstr "Para procurar canais que começam com #, procure pelo nome do canal sem o sinal # no início (anope em vez de #anope)."
#: ../modules/chanserv/cs_list.cpp:78 ../modules/nickserv/ns_list.cpp:122
#, c-format
msgid "List of entries matching %s:"
msgstr "Lista de entradas correspondentes a %s:"
#: ../modules/chanserv/cs_list.cpp:85
msgid "{name}"
msgstr "{name}"
#: ../modules/chanserv/cs_list.cpp:86
msgid "{name} ({description})"
msgstr "{name} ({description})"
#: ../modules/chanserv/cs_list.cpp:125
msgid "[Suspended]"
msgstr "[Suspenso]"
#: ../modules/chanserv/cs_list.cpp:135 ../modules/nickserv/ns_list.cpp:124
#, c-format
msgid "End of list - %d/%d matches shown."
msgstr "Fim da lista - %d/%d correspondências exibidas."
#: ../modules/chanserv/cs_list.cpp:143
msgid "Lists all registered channels matching the given pattern. Channels with the PRIVATE option set will only be displayed to Services Operators with the proper access. Channels with the NOEXPIRE option set will have a ! prefixed to the channel for Services Operators to see.\n\nNote that a preceding '#' specifies a range, channel names are to be written without '#'.\n\nIf the SUSPENDED or NOEXPIRE options are given, only channels which, respectively, are SUSPENDED or have the NOEXPIRE flag set will be displayed. If multiple options are given, all channels matching at least one option will be displayed. Note that these options are limited to Services Operators."
msgstr "Lista todos os canais registrados que correspondem ao padrão informado. Os canais com a opção PRIVATE definida só serão exibidos aos Operadores de Serviços que tiverem o acesso adequado. Os canais com a opção NOEXPIRE definida terão um ! prefixado ao nome do canal para que os Operadores de Serviços possam vê-los.\n\nObserve que um '#' à frente especifica um intervalo; os nomes dos canais devem ser escritos sem o '#'.\n\nSe as opções SUSPENDED ou NOEXPIRE forem informadas, somente os canais que, respectivamente, estiverem SUSPENDED ou tiverem a flag NOEXPIRE definida serão exibidos. Se mais de uma opção for informada, todos os canais que corresponderem a pelo menos uma opção serão exibidos. Observe que essas opções são restritas a Operadores de Serviços."
#: ../modules/chanserv/cs_list.cpp:161
msgid "Lists all registered channels with anope in their name (case insensitive). "
msgstr "Lista todos os canais registrados com anope no nome (sem diferenciar maiúsculas de minúsculas). "
#: ../modules/chanserv/cs_list.cpp:164
msgid "Lists all registered channels within the given range (51-100)."
msgstr "Lista todos os canais registrados dentro do intervalo informado (51-100)."
#: ../modules/chanserv/cs_list.cpp:167
msgid "Lists all registered channels that have been set to not expire."
msgstr "Lista todos os canais registrados que foram definidos para não expirar."
#: ../modules/chanserv/cs_list.cpp:170
msgid "Lists all registered channels that have been suspended."
msgstr "Lista todos os canais registrados que foram suspensos."
#: ../modules/chanserv/cs_list.cpp:178 ../modules/nickserv/ns_list.cpp:173
#: ../modules/operserv/os_forbid.cpp:498 ../modules/operserv/os_ignore.cpp:422
#: ../modules/operserv/os_list.cpp:132 ../modules/operserv/os_list.cpp:275
#, c-format
msgid "Regex matches are also supported using the %s engine. Enclose your pattern in // if this is desired."
msgstr "Também há suporte a correspondências regex usando o mecanismo %s. Coloque o padrão entre // se quiser isso."
#: ../modules/chanserv/cs_list.cpp:194
msgid "Hide channel from the LIST command"
msgstr "Ocultar o canal do comando LIST"
#: ../modules/chanserv/cs_list.cpp:228
#, c-format
msgid "Private option for %s is now on."
msgstr "A opção privada de %s está agora ativada."
#: ../modules/chanserv/cs_list.cpp:234
#, c-format
msgid "Private option for %s is now off."
msgstr "A opção privada de %s está agora desativada."
#: ../modules/chanserv/cs_list.cpp:244
msgid "Enables or disables the private option for a channel."
msgstr "Ativa ou desativa a opção private de um canal."
#: ../modules/chanserv/cs_list.cpp:250
#, c-format
msgid "When private is set, the channel will not appear in %s's %s command."
msgstr "Quando private está definido, o canal não aparecerá no comando %s do %s."
#: ../modules/chanserv/cs_log.cpp:121
msgid "Configure channel logging settings"
msgstr "Configurar as opções de log do canal"
#: ../modules/chanserv/cs_log.cpp:123
msgid "channel command method [status]"
msgstr "canal comando método [status]"
#: ../modules/chanserv/cs_log.cpp:139
#, c-format
msgid "There currently are no logging configurations for %s."
msgstr "Atualmente não há configurações de log para %s."
#: ../modules/chanserv/cs_log.cpp:143
msgid "Service"
msgstr "Serviço"
#: ../modules/chanserv/cs_log.cpp:143
msgid "Command"
msgstr "Comando"
#: ../modules/chanserv/cs_log.cpp:143
msgid "Method"
msgstr "Método"
#: ../modules/chanserv/cs_log.cpp:144
msgid "{number}: {command} on {service}: {method}"
msgstr "{number}: {command} em {service}: {method}"
#: ../modules/chanserv/cs_log.cpp:158
#, c-format
msgid "Log list for %s:"
msgstr "Lista de logs para %s:"
#: ../modules/chanserv/cs_log.cpp:178 ../modules/chanserv/cs_log.cpp:203
#, c-format
msgid "%s is not a valid command."
msgstr "%s não é um comando válido."
#: ../modules/chanserv/cs_log.cpp:209
#, c-format
